# Password tunggal untuk login (ganti dengan password rahasiamu).
APP_PASSWORD=usagi

# Koneksi database Supabase.
# Gunakan CONNECTION POOLER (bukan "Direct connection"), karena direct connection
# hanya IPv6 dan biasanya tidak bisa diakses dari laptop/Vercel.
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL = "Transaction pooler" (port 6543) untuk runtime (serverless-friendly).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL = "Session pooler" (port 5432) untuk migrasi / prisma db push.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Server timezone. The business operates on WIB — set this on Vercel too
# (Project Settings -> Environment Variables) so month boundaries and default
# report ranges line up with local time instead of UTC. lib/date.ts also
# pins Asia/Jakarta explicitly, so this is belt-and-braces, not load-bearing.
TZ="Asia/Jakarta"
