# Password tunggal untuk login (ganti dengan password rahasiamu).
APP_PASSWORD=usagi

# Koneksi database Supabase.
# Gunakan CONNECTION POOLER (bukan "Direct connection"), karena direct connection
# hanya IPv6 dan biasanya tidak bisa diakses dari laptop/Vercel.
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL = "Transaction pooler" (port 6543) untuk runtime (serverless-friendly).
# pgbouncer=true wajib (transaction mode tidak mendukung prepared statements).
# connection_limit=1 mencegah tiap instance serverless membuka pool sendiri
# dan menghabiskan koneksi pooler saat traffic bersamaan. sslmode=require
# karena koneksi ini lewat internet publik (Vercel <-> Supabase).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#
# DIRECT_URL = "Session pooler" (port 5432) untuk migrasi / prisma db push.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Secret used to sign JWTs for the mobile app's API (app/api/v1/*, planned —
# see CLAUDE.md "Mobile client"). Not used yet; generate with
# `openssl rand -base64 32` once the API lands, and never reuse APP_PASSWORD
# for this.
API_JWT_SECRET=""

# Server timezone, for local dev only — Vercel reserves the TZ name and
# won't let you set it in the dashboard (or in vercel.json's env), so this
# can't be configured there. That's fine: lib/date.ts pins every date
# calculation to Asia/Jakarta (WIB, fixed UTC+7) explicitly and does not
# depend on this var, so production is correct without it either way. This
# line only matters if you want `next dev` to behave like a UTC host for
# testing.
TZ="Asia/Jakarta"
