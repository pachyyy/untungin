generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Produk {
  id         String             @id @default(cuid())
  nama       String
  supplierId String
  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  hargaModal Int
  stok       Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  items      PesananItem[]
  paketItems PesananPaketItem[]
  restock    Restock[]

  @@index([supplierId])
}

// A stock-in event: qty added and the price paid for it. hargaModal on Produk
// is a running weighted-average cost, recomputed from this at restock time —
// this row is the audit trail, not itself the source of the current cost.
model Restock {
  id        String   @id @default(cuid())
  produkId  String
  produk    Produk   @relation(fields: [produkId], references: [id], onDelete: Cascade)
  qty       Int
  hargaBeli Int // cost paid per unit for this batch
  tanggal   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([produkId, tanggal])
}

model Supplier {
  id     String   @id @default(cuid())
  nama   String
  kontak String?
  produk Produk[]
}

model Pesanan {
  id           String         @id @default(cuid())
  // Human-facing nota number printed on the struk (formatted with
  // StrukSetting.prefixNota, e.g. "INV-0042"). Sequential, never reused —
  // deleting an order leaves a gap. Existing rows were renumbered 1..N by
  // createdAt via scripts/backfill-nomor-nota.ts.
  nomor        Int            @unique @default(autoincrement())
  namaCustomer String
  noHp         String?
  customerId   String?
  customer     Customer?      @relation(fields: [customerId], references: [id])
  items        PesananItem[]
  pakets       PesananPaket[]
  status       String         @default("belum_bayar") // belum_bayar, nyicil, lunas
  // Denormalized copy of STATUS_RANK[status] (lib/calc.ts) — 0/1/2 for
  // belum_bayar/nyicil/lunas. Exists purely so the pesanan list can be
  // ORDER BY'd unpaid-first in Postgres, which can't sort a String column by
  // an arbitrary priority. Every site that writes `status` must also write
  // this; STATUS_RANK is the single source of truth for what value to use.
  statusRank   Int            @default(0)
  pembayaran   Pembayaran[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Which mobile device created this order — null for every order created
  // from the web app (single shared login, no per-device identity there).
  // SetNull rather than Cascade/Restrict: revoking or removing a Device must
  // never touch, let alone delete, the orders it created.
  createdByDeviceId String?
  createdByDevice   Device? @relation(fields: [createdByDeviceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([statusRank, createdAt])
  @@index([customerId])
  @@index([createdByDeviceId])
}

model Customer {
  id        String    @id @default(cuid())
  nama      String    @unique
  noHp      String?
  catatan   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pesanan   Pesanan[]
}

model PesananItem {
  id         String  @id @default(cuid())
  pesananId  String
  pesanan    Pesanan @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  produkId   String? // null for a dropshipped item typed directly on the order (no stock, see namaManual)
  produk     Produk? @relation(fields: [produkId], references: [id])
  namaManual String? // item name typed by hand; only set when produkId is null
  jumlah     Int
  hargaSaat  Int // snapshot harga jual saat transaksi
  modalSaat  Int     @default(0) // snapshot produk.hargaModal saat transaksi, or the typed HPP for a dropship item
  keterangan String? // optional free-text note (e.g. "warna merah, size L"), printed on the struk

  @@index([pesananId])
  @@index([produkId])
}

// A bundle line within an order: several products combined, sold at one price.
model PesananPaket {
  id         String             @id @default(cuid())
  pesananId  String
  pesanan    Pesanan            @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  nama       String             @default("Paket")
  harga      Int // bundle selling price for the whole paket
  keterangan String? // optional free-text note for the whole paket, printed on the struk
  komponen   PesananPaketItem[]

  @@index([pesananId])
}

model PesananPaketItem {
  id        String       @id @default(cuid())
  paketId   String
  paket     PesananPaket @relation(fields: [paketId], references: [id], onDelete: Cascade)
  produkId  String
  produk    Produk       @relation(fields: [produkId], references: [id])
  pcs       Int // how many pcs of this product are in the paket
  modalSaat Int          @default(0) // snapshot produk.hargaModal saat transaksi

  @@index([paketId])
  @@index([produkId])
}

// One payment against an order (single full payment, or one installment).
model Pembayaran {
  id        String   @id @default(cuid())
  pesananId String
  pesanan   Pesanan  @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  tanggal   DateTime
  metode    String? // "Cash" | "Transfer" | "QRIS" | "Lainnya"
  jumlah    Int
  jenis     String // "bayar" (single full payment) | "cicilan"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Which mobile device recorded this payment — null for the web app, same
  // reasoning as Pesanan.createdByDeviceId above.
  createdByDeviceId String?
  createdByDevice   Device? @relation(fields: [createdByDeviceId], references: [id], onDelete: SetNull)

  @@index([pesananId, tanggal])
  @@index([createdByDeviceId])
}

// A phone/tablet enrolled to use the mobile app. Not a user account — the
// app still has no concept of individual users, only devices with a role.
// Revoking access is `revokedAt = now()`, never a delete: deleting a Device
// row would null out createdByDeviceId on every order/payment it made (see
// onDelete: SetNull above), destroying attribution history for no reason.
model Device {
  id   String @id @default(cuid())
  nama String // owner-chosen label, e.g. "HP Rina"
  role String // "owner" | "staff"

  // SHA-256 of the *current* refresh token — never the token itself.
  // refreshTokenIssuedAt anchors the 60-day validity window (lib/api/auth.ts):
  // a token older than that is rejected even if the hash still matches.
  refreshTokenHash     String    @unique
  refreshTokenIssuedAt DateTime?

  // SHA-256 of the token this one *replaced*, kept for exactly one rotation.
  // A request presenting this hash means someone is reusing a token already
  // spent by a previous refresh — the legitimate client has since moved on
  // to the current one — which is the standard signal for a stolen refresh
  // token. Detecting that requires remembering the stale hash for one more
  // round; without it, a reused token would just look like "unknown token"
  // (a safe failure on its own, but not the "revoke the device" response
  // this is designed to give).
  previousRefreshTokenHash String? @unique

  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  pesanan    Pesanan[]
  pembayaran Pembayaran[]

  @@index([revokedAt])
}

// A one-time code the owner generates (from Settings on the web app) so a
// staff phone can enroll without ever learning APP_PASSWORD. Short-lived and
// single-use: `usedAt` is set the moment it creates a Device, and a request
// past `expiresAt` is rejected regardless.
model EnrollCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique // SHA-256 of the 8-char code shown to the owner
  nama      String // device label the owner chose when generating the code
  role      String    @default("staff")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Customization for the receipt image ("Cetak Struk") — a single row, id
// "default", edited from Settings → Edit Struk. Read via getStrukSetting()
// (lib/services/struk.ts), which creates it with these defaults on first use.
model StrukSetting {
  id                     String   @id @default("default")
  namaToko               String   @default("Untungin")
  logo                   String? // small data:image/... URL, resized client-side before upload
  tagline                String?
  alamat                 String?
  noWa                   String?
  sosmed                 String?
  infoPembayaran         String? // e.g. "BCA 123456 a.n. Budi" — multi-line
  footer                 String? // thank-you / return policy — multi-line
  prefixNota             String   @default("INV-")
  ukuranDefault          String   @default("80mm") // "80mm" | "a5"
  tampilkanStempel       Boolean  @default(true) // LUNAS / BELUM LUNAS stamp
  tampilkanKomponenPaket Boolean  @default(true) // list what's inside each paket
  updatedAt              DateTime @updatedAt
}
